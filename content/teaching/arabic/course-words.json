   "words": [
    {
     "id": "lexeme.arabic-greetings-address-1",
     "form_ar": "مَرْحَبًا",
     "meaning_en": "hello",
     "part_of_speech": "chunk",
     "root_ar": "ر-ح-ب",
     "root_reading": "r-ḥ-b",
     "example_ar": "مَرْحَبًا، أَنَا سَارَةُ.",
     "example_meaning_en": "Hello, I am Sarah.",
     "note": "A greeting for anyone; a common reply is مَرْحَبًا بِكَ (to a man) or مَرْحَبًا بِكِ (to a woman)."
    },
    {
     "id": "lexeme.arabic-greetings-address-2",
     "form_ar": "السَّلَامُ عَلَيْكُمْ",
     "meaning_en": "peace be upon you (a greeting)",
     "part_of_speech": "chunk",
     "root_ar": "س-ل-م",
     "root_reading": "s-l-m",
     "example_ar": "السَّلَامُ عَلَيْكُمْ. — وَعَلَيْكُمُ السَّلَامُ.",
     "example_meaning_en": "Peace be upon you. — And upon you peace.",
     "note": "Heard everywhere in the Arab world. The reply turns it round: وَعَلَيْكُمُ السَّلَامُ. عَلَيْكُمْ is plural but is used for one person too."
    },
    {
     "id": "lexeme.arabic-greetings-address-3",
     "form_ar": "صَبَاحُ الْخَيْرِ",
     "meaning_en": "good morning",
     "part_of_speech": "chunk",
     "root_ar": "ص-ب-ح",
     "root_reading": "ṣ-b-ḥ",
     "example_ar": "صَبَاحُ الْخَيْرِ. — صَبَاحُ النُّورِ.",
     "example_meaning_en": "Good morning. — Good morning (lit. morning of light).",
     "note": "The usual reply is صَبَاحُ النُّورِ. صَبَاح is “morning”; الْخَيْر is from the root خ-ي-ر, “good”."
    },
    {
     "id": "lexeme.arabic-greetings-address-4",
     "form_ar": "اِسْم",
     "meaning_en": "name",
     "part_of_speech": "noun",
     "root_ar": "س-م-و",
     "root_reading": "s-m-w",
     "example_ar": "مَا اسْمُكَ؟ — اِسْمِي سَامِرٌ.",
     "example_meaning_en": "What is your name? — My name is Sāmir.",
     "note": "After another word its first vowel isn't pronounced: مَا اسْمُكَ. اِسْمِي is “my name”. Plural أَسْمَاء. Classical dictionaries list it under س-م-و; Hans Wehr has it under alif."
    },
    {
     "id": "lexeme.arabic-greetings-address-5",
     "form_ar": "كَيْفَ حَالُكَ؟",
     "meaning_en": "how are you? (to a man)",
     "part_of_speech": "chunk",
     "root_ar": "ح-و-ل",
     "root_reading": "ḥ-w-l",
     "example_ar": "كَيْفَ حَالُكَ يَا سَامِرُ؟",
     "example_meaning_en": "How are you, Sāmir?",
     "note": "To a woman: كَيْفَ حَالُكِ؟ The word حَال means “state, condition”."
    },
    {
     "id": "lexeme.arabic-greetings-address-6",
     "form_ar": "بِخَيْرٍ",
     "meaning_en": "well, fine",
     "part_of_speech": "chunk",
     "root_ar": "خ-ي-ر",
     "root_reading": "kh-y-r",
     "example_ar": "أَنَا بِخَيْرٍ، شُكْرًا.",
     "example_meaning_en": "I am fine, thank you.",
     "note": "The answer to كَيْفَ حَالُكَ؟ The same for a man or a woman."
    },
    {
     "id": "lexeme.arabic-greetings-address-7",
     "form_ar": "تَشَرَّفْنَا",
     "meaning_en": "pleased to meet you",
     "part_of_speech": "chunk",
     "root_ar": "ش-ر-ف",
     "root_reading": "sh-r-f",
     "example_ar": "اِسْمِي لَيْلَى. — تَشَرَّفْنَا!",
     "example_meaning_en": "My name is Laylā. — Pleased to meet you!",
     "note": "Literally “we are honoured”. Said after names are exchanged."
    },
    {
     "id": "lexeme.arabic-greetings-address-8",
     "form_ar": "مَعَ السَّلَامَةِ",
     "meaning_en": "goodbye",
     "part_of_speech": "chunk",
     "root_ar": "س-ل-م",
     "root_reading": "s-l-m",
     "example_ar": "شُكْرًا، مَعَ السَّلَامَةِ.",
     "example_meaning_en": "Thank you, goodbye.",
     "note": "Literally “with safety”: the same root as السَّلَام."
    },
    {
     "id": "lexeme.arabic-greetings-address-9",
     "form_ar": "مَسَاءُ الْخَيْرِ",
     "meaning_en": "good evening",
     "part_of_speech": "chunk",
     "root_ar": "م-س-و",
     "root_reading": "m-s-w",
     "example_ar": "مَسَاءُ الْخَيْرِ. — مَسَاءُ النُّورِ.",
     "example_meaning_en": "Good evening. — Good evening (lit. evening of light).",
     "note": "Like صَبَاحُ الْخَيْرِ, with the starter word مَسَاء, “evening”."
    }
   ]
