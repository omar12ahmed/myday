# Settings ("secrets") for the ai-plan Edge Function — a TEMPLATE, kept as placeholders. Never put real values here.
#   1. Copy it to supabase/.ai-secrets.env (Git ignores that file) and fill in the key there.
#   2. Check the copy:  node supabase/check-ai-secrets.mjs   (compares it with the evaluated settings; never prints the key)
#   3. npx supabase secrets set --env-file supabase/.ai-secrets.env --project-ref nkslcgnbmxuhznvldfnz
#   4. Delete the copy afterwards if you like: the values now live only in Supabase.
# Each setting appears once. Model ids, addresses, settings and list prices below were checked against the providers'
# documentation on 3 Oct 2026, and match ai-eval/models.json (the settings that were evaluated).

# --- GLM-5.3-Flash on Z.ai's general (pay-as-you-go) API — the provisional choice ---
# Not the GLM Coding Plan address (/api/coding/paas/v4): Z.ai limits the Coding Plan to its supported coding tools.
# Thinking can't be switched off for GLM-5.3-Flash, so it runs at the lowest effort; reasoning counts as output, hence
# the bigger reply cap (Z.ai recommends at least 1024). The time limit stays under the app's own 40 seconds.
AI_PROVIDER=openai-compatible
AI_LABEL=GLM-5.3-Flash
AI_BASE_URL=https://api.z.ai/api/paas/v4
AI_MODEL=glm-5.3-flash
AI_API_KEY=
AI_EXTRA_BODY={"thinking": {"type": "enabled"}, "reasoning_effort": "low"}
AI_MAX_TOKENS_FIELD=max_tokens
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_MS=30000
# US$ per million tokens (docs.z.ai/guides/overview/pricing)
AI_PRICE_IN_PER_MTOK=0.15
AI_PRICE_OUT_PER_MTOK=0.5

# --- Or Qwen3.7 Plus / Flash on Alibaba Cloud Model Studio (Singapore / International) — replace the block above ---
# The address is your workspace's own, for the region of your key (Model Studio console). Other regions use their own
# address and prices (see ai-eval/models.json).
# AI_PROVIDER=openai-compatible
# AI_LABEL=Qwen3.7 Plus
# AI_BASE_URL=https://YOUR-WORKSPACE-ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen3.7-plus
# AI_API_KEY=
# AI_EXTRA_BODY={"enable_thinking": false}
# AI_MAX_TOKENS_FIELD=max_completion_tokens
# AI_MAX_OUTPUT_TOKENS=600
# AI_TIMEOUT_MS=30000
# US$ per million tokens, non-thinking, inputs up to 256K tokens (alibabacloud.com/help/en/model-studio/model-pricing).
# Qwen3.7 Flash: AI_MODEL=qwen3.7-flash, prices 0.03 / 0.13 (inputs up to 32K tokens).
# AI_PRICE_IN_PER_MTOK=0.4
# AI_PRICE_OUT_PER_MTOK=1.6

# --- Limits (per account) ---
AI_DAILY_LIMIT=20
AI_MONTHLY_BUDGET_USD=1
AI_MIN_SECONDS_BETWEEN=5

# --- Websites allowed to call it (browsers only; the sign-in check is what really guards it) ---
# The website (from release 1.2.0) and the dev server.
AI_ALLOWED_ORIGINS=https://omar12ahmed.github.io,http://localhost:5173

# --- The project's public key, if the function can't read it by itself (your sb_publishable_… key; it's public) ---
# MYDAY_PUBLISHABLE_KEY=

# --- To try the whole path without a model or a key ---
# AI_PROVIDER=mock
# AI_MODEL=mock:good
