},"readings":{"asset.arabic-profile":[{"text":"أَنَا لَيْلَى.","plain":"أنا ليلى.","spoken":"أَنَا لَيْلَى.","line":0},{"text":"أَنَا طَالِبَةٌ.","plain":"أنا طالبة.","spoken":"أَنَا طَالِبَةٌ.","line":0},{"text":"أَسْكُنُ فِي مَدِينَةٍ صَغِيرَةٍ.","plain":"أسكن في مدينة صغيرة.","spoken":"أَسْكُنُ فِي مَدِينَةٍ صَغِيرَةٍ.","line":0},{"text":"بَيْتِي قَرِيبٌ مِنَ الْمَدْرَسَةِ.","plain":"بيتي قريب من المدرسة.","spoken":"بَيْتِي قَرِيبٌ مِنَ الْمَدْرَسَةِ.","line":0},{"text":"أَدْرُسُ الْعَرَبِيَّةَ فِي الصَّبَاحِ، وَأَقْرَأُ فِي الْمَسَاءِ.","plain":"أدرس العربية في الصباح، وأقرأ في المساء.","spoken":"أَدْرُسُ الْعَرَبِيَّةَ فِي الصَّبَاحِ، وَأَقْرَأُ فِي الْمَسَاءِ.","line":0},{"text":"عِنْدِي كِتَابٌ جَدِيدٌ وَدَفْتَرٌ صَغِيرٌ.","plain":"عندي كتاب جديد ودفتر صغير.","spoken":"عِنْدِي كِتَابٌ جَدِيدٌ وَدَفْتَرٌ صَغِيرٌ.","line":0}],"asset.arabic-room":[{"text":"هَذِهِ غُرْفَةٌ صَغِيرَةٌ.","plain":"هذه غرفة صغيرة.","spoken":"هَذِهِ غُرْفَةٌ صَغِيرَةٌ.","line":0},{"text":"فِي الْغُرْفَةِ مَكْتَبٌ وَكُرْسِيٌّ.","plain":"في الغرفة مكتب وكرسي.","spoken":"فِي الْغُرْفَةِ مَكْتَبٌ وَكُرْسِيٌّ.","line":0},{"text":"عَلَى الْمَكْتَبِ ثَلَاثَةُ كُتُبٍ.","plain":"على المكتب ثلاثة كتب.","spoken":"عَلَى الْمَكْتَبِ ثَلَاثَةُ كُتُبٍ.","line":0},{"text":"الْكُتُبُ جَدِيدَةٌ.","plain":"الكتب جديدة.","spoken":"الْكُتُبُ جَدِيدَةٌ.","line":0},{"text":"هَذَا كِتَابُ لَيْلَى، وَذَلِكَ كِتَابُ سَامِي.","plain":"هذا كتاب ليلى، وذلك كتاب سامي.","spoken":"هَذَا كِتَابُ لَيْلَى، وَذَلِكَ كِتَابُ سَامِي.","line":0},{"text":"بَابُ الْغُرْفَةِ مَفْتُوحٌ.","plain":"باب الغرفة مفتوح.","spoken":"بَابُ الْغُرْفَةِ مَفْتُوحٌ.","line":0}],"asset.arabic-introduction-dialogue":[{"text":"سَامِي: مَرْحَبًا.","plain":"سامي: مرحبا.","spoken":"مَرْحَبًا.","line":0},{"text":"مَا اسْمُكِ؟","plain":"ما اسمك؟","spoken":"مَا اسْمُكِ؟","line":0},{"text":"لَيْلَى: اسْمِي لَيْلَى.","plain":"ليلى: اسمي ليلى.","spoken":"اسْمِي لَيْلَى.","line":1},{"text":"وَمَا اسْمُكَ؟","plain":"وما اسمك؟","spoken":"وَمَا اسْمُكَ؟","line":1},{"text":"سَامِي: اسْمِي سَامِي.","plain":"سامي: اسمي سامي.","spoken":"اسْمِي سَامِي.","line":2},{"text":"هَلْ أَنْتِ طَالِبَةٌ؟","plain":"هل أنت طالبة؟","spoken":"هَلْ أَنْتِ طَالِبَةٌ؟","line":2},{"text":"لَيْلَى: نَعَمْ، أَنَا طَالِبَةٌ.","plain":"ليلى: نعم، أنا طالبة.","spoken":"نَعَمْ، أَنَا طَالِبَةٌ.","line":3},{"text":"هَلْ تَدْرُسُ الْعَرَبِيَّةَ؟","plain":"هل تدرس العربية؟","spoken":"هَلْ تَدْرُسُ الْعَرَبِيَّةَ؟","line":3},{"text":"سَامِي: نَعَمْ.","plain":"سامي: نعم.","spoken":"نَعَمْ.","line":4},{"text":"أَدْرُسُ الْعَرَبِيَّةَ فِي الْمَسَاءِ.","plain":"أدرس العربية في المساء.","spoken":"أَدْرُسُ الْعَرَبِيَّةَ فِي الْمَسَاءِ.","line":4},{"text":"لَيْلَى: أَنَا أَدْرُسُ فِي الصَّبَاحِ.","plain":"ليلى: أنا أدرس في الصباح.","spoken":"أَنَا أَدْرُسُ فِي الصَّبَاحِ.","line":5}],"asset.arabic-appointment":[{"text":"مَرْحَبًا يَا سَامِي.","plain":"مرحبا يا سامي.","spoken":"مَرْحَبًا يَا سَامِي.","line":0},{"text":"مَوْعِدُنَا يَوْمَ الثُّلَاثَاءِ فِي السَّاعَةِ الثَّالِثَةِ.","plain":"موعدنا يوم الثلاثاء في الساعة الثالثة.","spoken":"مَوْعِدُنَا يَوْمَ الثُّلَاثَاءِ فِي السَّاعَةِ الثَّالِثَةِ.","line":0},{"text":"الْمَكْتَبَةُ بِجَانِبِ الْمَدْرَسَةِ.","plain":"المكتبة بجانب المدرسة.","spoken":"الْمَكْتَبَةُ بِجَانِبِ الْمَدْرَسَةِ.","line":0},{"text":"أَنَا فِي الْمَكْتَبَةِ فِي السَّاعَةِ الثَّانِيَةِ.","plain":"أنا في المكتبة في الساعة الثانية.","spoken":"أَنَا فِي الْمَكْتَبَةِ فِي السَّاعَةِ الثَّانِيَةِ.","line":0},{"text":"إِلَى اللِّقَاءِ!","plain":"إلى اللقاء!","spoken":"إِلَى اللِّقَاءِ!","line":0},{"text":"لَيْلَى","plain":"ليلى","spoken":"لَيْلَى","line":1}],"asset.arabic-routine":[{"text":"أَسْتَيْقِظُ فِي الصَّبَاحِ.","plain":"أستيقظ في الصباح.","spoken":"أَسْتَيْقِظُ فِي الصَّبَاحِ.","line":0},{"text":"أَشْرَبُ الْمَاءَ، ثُمَّ أَقْرَأُ كِتَابًا.","plain":"أشرب الماء، ثم أقرأ كتابا.","spoken":"أَشْرَبُ الْمَاءَ، ثُمَّ أَقْرَأُ كِتَابًا.","line":0},{"text":"أَدْرُسُ الْعَرَبِيَّةَ نِصْفَ سَاعَةٍ.","plain":"أدرس العربية نصف ساعة.","spoken":"أَدْرُسُ الْعَرَبِيَّةَ نِصْفَ سَاعَةٍ.","line":0},{"text":"بَعْدَ ذَلِكَ أَذْهَبُ إِلَى الْعَمَلِ.","plain":"بعد ذلك أذهب إلى العمل.","spoken":"بَعْدَ ذَلِكَ أَذْهَبُ إِلَى الْعَمَلِ.","line":0},{"text":"فِي الْمَسَاءِ أَكْتُبُ جُمَلًا قَصِيرَةً.","plain":"في المساء أكتب جملا قصيرة.","spoken":"فِي الْمَسَاءِ أَكْتُبُ جُمَلًا قَصِيرَةً.","line":0},{"text":"أَنَا أُحِبُّ الْقِرَاءَةَ، وَلَكِنَّ الْكِتَابَةَ صَعْبَةٌ أَحْيَانًا.","plain":"أنا أحب القراءة، ولكن الكتابة صعبة أحيانا.","spoken":"أَنَا أُحِبُّ الْقِرَاءَةَ، وَلَكِنَّ الْكِتَابَةَ صَعْبَةٌ أَحْيَانًا.","line":0}],"asset.arabic-weekend":[{"text":"فِي يَوْمِ السَّبْتِ زُرْتُ صَدِيقِي سَامِي.","plain":"في يوم السبت زرت صديقي سامي.","spoken":"فِي يَوْمِ السَّبْتِ زُرْتُ صَدِيقِي سَامِي.","line":0},{"text":"كَانَ الْجَوُّ جَمِيلًا، فَذَهَبْنَا إِلَى الْحَدِيقَةِ.","plain":"كان الجو جميلا، فذهبنا إلى الحديقة.","spoken":"كَانَ الْجَوُّ جَمِيلًا، فَذَهَبْنَا إِلَى الْحَدِيقَةِ.","line":0},{"text":"جَلَسْنَا تَحْتَ شَجَرَةٍ وَتَحَدَّثْنَا عَنِ الدِّرَاسَةِ.","plain":"جلسنا تحت شجرة وتحدثنا عن الدراسة.","spoken":"جَلَسْنَا تَحْتَ شَجَرَةٍ وَتَحَدَّثْنَا عَنِ الدِّرَاسَةِ.","line":0},{"text":"بَعْدَ ذَلِكَ أَرَدْنَا أَنْ نَذْهَبَ إِلَى الْمَكْتَبَةِ، وَلَكِنَّهَا كَانَتْ مُغْلَقَةً.","plain":"بعد ذلك أردنا أن نذهب إلى المكتبة، ولكنها كانت مغلقة.","spoken":"بَعْدَ ذَلِكَ أَرَدْنَا أَنْ نَذْهَبَ إِلَى الْمَكْتَبَةِ، وَلَكِنَّهَا كَانَتْ مُغْلَقَةً.","line":0},{"text":"لَمْ نَدْخُلِ الْمَكْتَبَةَ.","plain":"لم ندخل المكتبة.","spoken":"لَمْ نَدْخُلِ الْمَكْتَبَةَ.","line":0},{"text":"عُدْنَا إِلَى الْبَيْتِ وَقَرَأْنَا قِصَّةً قَصِيرَةً.","plain":"عدنا إلى البيت وقرأنا قصة قصيرة.","spoken":"عُدْنَا إِلَى الْبَيْتِ وَقَرَأْنَا قِصَّةً قَصِيرَةً.","line":0},{"text":"فِي الْأُسْبُوعِ الْقَادِمِ سَنَزُورُ الْمَكْتَبَةَ يَوْمَ الْجُمُعَةِ.","plain":"في الأسبوع القادم سنزور المكتبة يوم الجمعة.","spoken":"فِي الْأُسْبُوعِ الْقَادِمِ سَنَزُورُ الْمَكْتَبَةَ يَوْمَ الْجُمُعَةِ.","line":0},{"text":"سَأَتَأَكَّدُ مِنْ وَقْتِ افْتِتَاحِهَا قَبْلَ الزِّيَارَةِ.","plain":"سأتأكد من وقت افتتاحها قبل الزيارة.","spoken":"سَأَتَأَكَّدُ مِنْ وَقْتِ افْتِتَاحِهَا قَبْلَ الزِّيَارَةِ.","line":0}],"asset.arabic-changed-plan":[{"text":"لَيْلَى: أُرِيدُ أَنْ أَدْرُسَ مَعَكِ يَوْمَ الثُّلَاثَاءِ.","plain":"ليلى: أريد أن أدرس معك يوم الثلاثاء.","spoken":"أُرِيدُ أَنْ أَدْرُسَ مَعَكِ يَوْمَ الثُّلَاثَاءِ.","line":0},{"text":"هَلْ تَسْتَطِيعِينَ أَنْ تَحْضُرِي فِي السَّاعَةِ الثَّالِثَةِ؟","plain":"هل تستطيعين أن تحضري في الساعة الثالثة؟","spoken":"هَلْ تَسْتَطِيعِينَ أَنْ تَحْضُرِي فِي السَّاعَةِ الثَّالِثَةِ؟","line":0},{"text":"نُور: لَا أَسْتَطِيعُ، لِأَنَّ عِنْدِي مَوْعِدًا.","plain":"نور: لا أستطيع، لأن عندي موعدا.","spoken":"لَا أَسْتَطِيعُ، لِأَنَّ عِنْدِي مَوْعِدًا.","line":1},{"text":"أَسْتَطِيعُ أَنْ أَحْضُرَ يَوْمَ الْأَرْبِعَاءِ.","plain":"أستطيع أن أحضر يوم الأربعاء.","spoken":"أَسْتَطِيعُ أَنْ أَحْضُرَ يَوْمَ الْأَرْبِعَاءِ.","line":1},{"text":"لَيْلَى: هَلْ تُنَاسِبُكِ السَّاعَةُ الرَّابِعَةُ؟","plain":"ليلى: هل تناسبك الساعة الرابعة؟","spoken":"هَلْ تُنَاسِبُكِ السَّاعَةُ الرَّابِعَةُ؟","line":2},{"text":"نُور: نَعَمْ.","plain":"نور: نعم.","spoken":"نَعَمْ.","line":3},{"text":"أَيْنَ سَنَلْتَقِي؟","plain":"أين سنلتقي؟","spoken":"أَيْنَ سَنَلْتَقِي؟","line":3},{"text":"لَيْلَى: فِي الْمَكْتَبَةِ.","plain":"ليلى: في المكتبة.","spoken":"فِي الْمَكْتَبَةِ.","line":4},{"text":"سَأُرْسِلُ إِلَيْكِ الْعُنْوَانَ.","plain":"سأرسل إليك العنوان.","spoken":"سَأُرْسِلُ إِلَيْكِ الْعُنْوَانَ.","line":4},{"text":"نُور: شُكْرًا.","plain":"نور: شكرا.","spoken":"شُكْرًا.","line":5},{"text":"إِذَنْ مَوْعِدُنَا يَوْمَ الْأَرْبِعَاءِ فِي السَّاعَةِ الرَّابِعَةِ.","plain":"إذن موعدنا يوم الأربعاء في الساعة الرابعة.","spoken":"إِذَنْ مَوْعِدُنَا يَوْمَ الْأَرْبِعَاءِ فِي السَّاعَةِ الرَّابِعَةِ.","line":5}],"asset.arabic-notice":[{"text":"تَفْتَحُ الْمَكْتَبَةُ أَبْوَابَهَا مِنَ السَّاعَةِ التَّاسِعَةِ صَبَاحًا إِلَى السَّاعَةِ الْخَامِسَةِ مَسَاءً.","plain":"تفتح المكتبة أبوابها من الساعة التاسعة صباحا إلى الساعة الخامسة مساء.","spoken":"تَفْتَحُ الْمَكْتَبَةُ أَبْوَابَهَا مِنَ السَّاعَةِ التَّاسِعَةِ صَبَاحًا إِلَى السَّاعَةِ الْخَامِسَةِ مَسَاءً.","line":0},{"text":"تُغْلَقُ يَوْمَ السَّبْتِ.","plain":"تغلق يوم السبت.","spoken":"تُغْلَقُ يَوْمَ السَّبْتِ.","line":0},{"text":"يَسْتَطِيعُ الْقُرَّاءُ اسْتِعَارَةَ ثَلَاثَةِ كُتُبٍ لِمُدَّةِ أُسْبُوعَيْنِ.","plain":"يستطيع القراء استعارة ثلاثة كتب لمدة أسبوعين.","spoken":"يَسْتَطِيعُ الْقُرَّاءُ اسْتِعَارَةَ ثَلَاثَةِ كُتُبٍ لِمُدَّةِ أُسْبُوعَيْنِ.","line":0},{"text":"لَا يُسْمَحُ بِالطَّعَامِ فِي غُرْفَةِ الْقِرَاءَةِ.","plain":"لا يسمح بالطعام في غرفة القراءة.","spoken":"لَا يُسْمَحُ بِالطَّعَامِ فِي غُرْفَةِ الْقِرَاءَةِ.","line":0},{"text":"لِطَلَبِ الْمُسَاعَدَةِ، يُرْجَى سُؤَالُ الْمُوَظَّفِ عِنْدَ الْمَدْخَلِ.","plain":"لطلب المساعدة، يرجى سؤال الموظف عند المدخل.","spoken":"لِطَلَبِ الْمُسَاعَدَةِ، يُرْجَى سُؤَالُ الْمُوَظَّفِ عِنْدَ الْمَدْخَلِ.","line":0}]}}