# Cloud sync for the published MyDay (see ../supabase/README.md). Both values are public by design: they're built
# into the app that every visitor downloads, and Row Level Security protects the data. Never put a secret key here
# (vite.config.ts refuses to build with one).
VITE_SUPABASE_URL=https://nkslcgnbmxuhznvldfnz.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_MmZ0jwr5chMxlzFoQOVP7Q_SW8Xx1wW

# AI help on Today ("Help me adjust today", "Add what's on my mind"), from release 1.2.0: requests go only to the
# ai-plan Edge Function, for signed-in accounts; no AI key is ever in the app. Delete this line to switch it off.
VITE_AI=edge
