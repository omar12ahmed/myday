# The website built by deploy/build-site.sh (published, never committed here)
site/
# Local design directions, browser reports and synthetic screenshots
.taste-skill/
# Personal backups and copies of saved data: never commit these
myday-export-*.json
myday-saved-copy-*.json
myday-unreadable-*.json
*backup*.json

# AI evaluation: build output, results and local keys
ai-eval/.build/
ai-eval/results/
ai-eval/.env.local

# Supabase secrets: never in Git (the committed template is supabase/ai-secrets.example.env)
supabase/.ai-secrets.env
supabase/**/.env
supabase/**/.env.*
supabase/**/*.secret.env
# A disposable PostgreSQL for tests/ai-concurrency.test.js (see that file)
tests/.pgtools/
# Deno for tests/ai-deno.test.js (see that file)
tests/.denotools/
# The Supabase CLI's own cache (project ref, versions)
supabase/.temp/

# The Arabic clips copied for the build from content/arabic-audio/ by app/scripts/prepare-audio.mjs
app/public/arabic-audio/

# Python byte-code (tests/live/run.py)
__pycache__/
